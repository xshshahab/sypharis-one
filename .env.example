# Copy this file to .env and fill in your own values.
# NEVER put real keys in this file - it is committed to git. Only .env is ignored.

# LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Web search (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Flights (AviationStack)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
# Must include /flights. Free plan = http only; paid plans can use https.
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1/flights

# Default departure airport (3-letter IATA code). DEL = Delhi, BOM = Mumbai, BLR = Bengaluru
DEFAULT_ORIGIN_IATA=DEL

# Render Database Configuration
DATABASE_URL=your_render_database_url_here

# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_langsmith_project_name_here
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Frontend URL(s) allowed to call the API (comma-separated). Default: Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
